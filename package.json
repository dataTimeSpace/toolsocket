{
  "name": "toolsocket",
  "version": "2.1.2-nb.4",
  "description": "A communication layer built on top of WebSocket for Node.js and browsers. Includes ToolSocketNB: a non-blocking, prioritized, flow-controlled transport layer (API-compatible).",
  "main": "src/index.js",
  "scripts": {
    "test": "npm run build && npm run lint && jest",
    "coverage": "jest --coverage",
    "lint": "eslint .",
    "build": "esbuild src/index.js --bundle --minify --outfile=dist/toolsocket.js --format=iife --global-name=ToolSocket --external:ws",
    "build:browser": "esbuild src/index.browser.js --bundle --minify --outfile=dist/toolsocket.browser.js --format=iife --global-name=ToolSocket --external:ws --external:os --external:crypto",
    "test:conformance-nb": "jest -c jest.nb.config.json",
    "test:nb": "node test-nb/nb_smoke.js && node test-nb/nb_reconnect.js && node test-nb/nb_priority.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptcrealitylab/toolsocket.git"
  },
  "keywords": [
    "websocket",
    "client",
    "server",
    "browser",
    "node"
  ],
  "author": "Valentin Heun",
  "contributors": [
    "Daniel Dangond <ddangond@ptc.com>"
  ],
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/ptcrealitylab/toolsocket/issues"
  },
  "homepage": "https://github.com/ptcrealitylab/toolsocket#readme",
  "dependencies": {
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "regenerator-runtime": "^0.14.1"
  }
}
